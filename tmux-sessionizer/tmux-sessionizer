#!/usr/bin/env bash
if [[ $# -eq 1 ]]; then
    selected=$1
else
    selected=$(find ~/work ~/dotfiles -mindepth 1 -maxdepth 1 -type d 2>/dev/null | fzf)

fi
[[ -z $selected ]] && exit 0

name=$(basename "$selected" | tr . _)

if ! tmux has-session -t="$name" 2>/dev/null; then
    tmux new-session -ds "$name" -c "$selected"
fi

if [[ -z $TMUX ]]; then
    tmux attach -t "$name"
else
    tmux switch-client -t "$name"
fi
